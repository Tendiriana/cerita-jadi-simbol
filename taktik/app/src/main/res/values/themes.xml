<resources>
    <style name="Theme.TakTik" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorPrimary">@color/acc</item>
        <item name="colorAccent">@color/acc</item>
    </style>
    <!-- Halaman pembuka saat aplikasi dibuka -->
    <style name="Theme.TakTik.Pembuka" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.TakTik</item>
    </style>
    <color name="bg">#FBF8F0</color>
    <color name="acc">#1F3B8A</color>
    <color name="ic_bg">#0F6E6A</color>
</resources>
